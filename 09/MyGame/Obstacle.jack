class Obstacle {
    field int x, y;
    field int size;
    field int speed;

    constructor Obstacle new(int Ax, int Asize, int Aspeed) {
        let x = Ax;
        let y = 0;
        let size = Asize;
        let speed = Aspeed;
        do draw();
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method void draw() {
        do Screen.setColor(true);
        do Screen.drawRectangle(x, y, x + size, y + size);
        return;
    }

    method void erase() {
        do Screen.setColor(false);
        do Screen.drawRectangle(x, y, x + size, y + size);
        return;
    }

    method boolean fall() {
        do erase();
        let y = y + speed;
        if ((y + size) > 250) {
            return true;
        }
        do draw();
        return false;
    }

    method void reset(int newX) {
        let x = newX;
        let y = 0;
        do draw();
        return;
    }

    method int getX() { return x; }
    method int getY() { return y; }
    method int getSize() { return size; }
}