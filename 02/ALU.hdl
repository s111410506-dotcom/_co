// File name: projects/02/ALU.hdl

/**
 * The ALU (Arithmetic Logic Unit).
 * Computes one of the following functions:
 * x+y, x-y, y-x, 0, 1, -1, x, y, -x, -y, !x, !y,
 * x+1, y+1, x-1, y-1, x&y, x|y on two 16-bit inputs, 
 * according to 6 input bits denoted zx,nx,zy,ny,f,no.
 * In addition, the ALU computes two 1-bit outputs:
 * if the ALU output == 0, zr is set to 1; otherwise zr is set to 0;
 * if the ALU output < 0, ng is set to 1; otherwise ng is set to 0.
 */

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute out = x + y (if 1) or x & y (if 0)
        no; // negate the out output?

    OUT 
        out[16], // 16-bit output
        zr, // 1 if (out == 0), 0 otherwise
        ng; // 1 if (out < 0),  0 otherwise

    PARTS:
    // ----------------------------------------------------
    // 1. 處理 X 輸入端 (zx, nx)
    // ----------------------------------------------------
    // zx: 如果 zx=1，將 x 設為全 0 (false)
    Mux16(a=x, b=false, sel=zx, out=x1);
    
    // nx: 如果 nx=1，將 x 反轉 (!x)
    Not16(in=x1, out=notx1);
    Mux16(a=x1, b=notx1, sel=nx, out=x2);

    // ----------------------------------------------------
    // 2. 處理 Y 輸入端 (zy, ny)
    // ----------------------------------------------------
    // zy: 如果 zy=1，將 y 設為全 0 (false)
    Mux16(a=y, b=false, sel=zy, out=y1);
    
    // ny: 如果 ny=1，將 y 反轉 (!y)
    Not16(in=y1, out=noty1);
    Mux16(a=y1, b=noty1, sel=ny, out=y2);

    // ----------------------------------------------------
    // 3. 執行主要運算 (f)
    // ----------------------------------------------------
    // 分別計算 (x + y) 與 (x & y)，再根據 f 決定要輸出哪一個
    Add16(a=x2, b=y2, out=addResult);
    And16(a=x2, b=y2, out=andResult);
    Mux16(a=andResult, b=addResult, sel=f, out=fResult);

    // ----------------------------------------------------
    // 4. 處理最終輸出與狀態標籤 (no, ng, zr)
    // ----------------------------------------------------
    // no: 如果 no=1，將運算結果反轉
    // 💡 技巧：在這裡我們同時將輸出的 16 位元進行拆解，方便後續判斷 ng 與 zr
    Not16(in=fResult, out=notFResult);
    Mux16(a=fResult, b=notFResult, sel=no, out=out, out[15]=ng, out[0..7]=outLow, out[8..15]=outHigh);

    // ng (負數標籤):
    // 二補數系統中，只要最高位元 (out[15]) 為 1 就是負數。
    // 在上方最後一個 Mux16 中，我們已經將 out[15] 直接接給 ng 了！

    // zr (零值標籤):
    // 判斷輸出是否為 0 (亦即 16 個位元是否全部都是 0)
    // 將拆解出來的低 8 位元 (outLow) 與高 8 位元 (outHigh) 分別丟入 Or8Way
    Or8Way(in=outLow, out=orLow);
    Or8Way(in=outHigh, out=orHigh);
    // 只要有任何一個位元是 1，orAll 就會是 1
    Or(a=orLow, b=orHigh, out=orAll);
    // 反轉結果：如果是 0，則輸出 1 (代表 zr=1)
    Not(in=orAll, out=zr);
}