// File name: projects/01/Or.hdl

/**
 * Or gate:
 * out = 1 if (a == 1 or b == 1)
 *       0 otherwise
 */

CHIP Or {
    IN a, b;
    OUT out;

    PARTS:
    // 第一步：將 a 進行 Not 反轉
    Not(in=a, out=notA);
    
    // 第二步：將 b 進行 Not 反轉
    Not(in=b, out=notB);
    
    // 第三步：將反轉後的 notA 與 notB 傳入 Nand 閘
    Nand(a=notA, b=notB, out=out);
}
