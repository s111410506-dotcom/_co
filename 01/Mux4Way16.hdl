// File name: projects/01/Mux4Way16.hdl

/**
 * 4-way 16-bit multiplexor:
 * out = a if sel == 00
 *       b if sel == 01
 *       c if sel == 10
 *       d if sel == 11
 */

CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];

    PARTS:
    // 第一層：使用 sel[0] 在 a, b 之間二選一，以及在 c, d 之間二選一
    // 當 sel[0] 為 0 時選 a/c，為 1 時選 b/d
    Mux16(a=a, b=b, sel=sel[0], out=muxAB);
    Mux16(a=c, b=d, sel=sel[0], out=muxCD);
    
    // 第二層：使用 sel[1] 決定最終要輸出 AB 組還是 CD 組的結果
    // 當 sel[1] 為 0 時選 muxAB，為 1 時選 muxCD
    Mux16(a=muxAB, b=muxCD, sel=sel[1], out=out);
}