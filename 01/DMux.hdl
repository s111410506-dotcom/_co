/**
 * Demultiplexor:
 * {a, b} = {in, 0} if sel == 0
 *          {0, in} if sel == 1
 */

CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    // 第一步：取得 sel 的反轉訊號 (notSel)
    Not(in=sel, out=notSel);
    
    // 第二步：處理輸出 a (in AND NOT sel)
    And(a=in, b=notSel, out=a);
    
    // 第三步：處理輸出 b (in AND sel)
    And(a=in, b=sel, out=b);
}
